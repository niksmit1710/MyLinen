DEBUG=False
SECRET_KEY=replace-with-a-new-django-secret-key

DATABASE_URL=replace-with-render-postgres-url

CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Or use these instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
# CLOUDINARY_API_KEY=replace-with-api-key
# CLOUDINARY_API_SECRET=replace-with-api-secret

RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret

EMAIL_HOST_USER=replace-with-email-user
EMAIL_HOST_PASSWORD=replace-with-email-app-password
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
EMAIL_SEND_ASYNC=False
DEFAULT_FROM_EMAIL=MyLinen <noreply@mylinen.com>

SITE_URL=https://mylinen.onrender.com

# Optional: set all three to create/update an admin during build.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Optional: dotted Python path to an SMS sender function for production OTP delivery.
LOGIN_OTP_SENDER=
